<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenHABTestSuite</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>CSharpOpenHABTestSuite</PackageId>
    <Version>2.0.1</Version>
    <Authors>Michael Christian Dörflinger</Authors>
    <Description>Tests for openHAB installations (items, things, rules, links, persistence, sitemaps) – the C# counterpart of openhab-test-suite, built on CSharpOpenHABRestClient 2.</Description>
    <PackageTags>openhab;smarthome;testing;rest;home-automation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Michdo93/csharp-openhab-test-suite</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Michdo93/csharp-openhab-test-suite</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CSharpOpenHABRestClient" Version="2.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
